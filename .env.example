# Backend settings (export these in the backend shell or load with your shell tooling)
LUNA_DATABASE_PATH=./data/sreema.sqlite3
LUNA_STORE_RAW_EVENTS=true

# Optional deterministic detection thresholds
LUNA_RULE_REPEATED_THRESHOLD=3
LUNA_RULE_REPEATED_WINDOW_MINUTES=5
LUNA_RULE_SUCCESS_THRESHOLD=3
LUNA_RULE_SUCCESS_WINDOW_MINUTES=10
LUNA_RULE_BURST_THRESHOLD=10
LUNA_RULE_BURST_WINDOW_MINUTES=5
LUNA_RULE_MULTIPLE_ACCOUNT_THRESHOLD=5
LUNA_RULE_MULTIPLE_ACCOUNT_WINDOW_MINUTES=5

# Frontend (.env.local in frontend/)
VITE_API_BASE_URL=http://127.0.0.1:8000
